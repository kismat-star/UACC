// QR File Collector — Prisma schema
// Admin generates a QR for a "Session". Students scan & upload image/PDF.
// Admin downloads / prints / deletes files. Auto-delete supported.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique // short code embedded in the QR url (?upload=CODE)
  createdAt DateTime @default(now())
  closed    Boolean  @default(false) // closed sessions stop accepting uploads
  files     File[]
}

model File {
  id          String    @id @default(cuid())
  sessionId   String
  session     Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  filename    String // original file name from student
  storedName  String // unique name on disk (inside uploads/)
  mimeType    String
  size        Int // bytes
  fileType    String // "image" | "pdf"
  pageCount   Int?   @default(1)
  studentName String? // optional label from student
  createdAt   DateTime  @default(now())
  printedAt   DateTime?
  printed     Boolean   @default(false)
  expiresAt   DateTime? // when set, file auto-deletes after this time
}

// Simple key/value store for admin settings (singleton rows keyed by id).
model Setting {
  id    String @id
  value String
}
